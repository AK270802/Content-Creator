# Application
APP_NAME=Content Creation API
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_ORIGINS=https://reelzoy.com,https://www.reelzoy.com,http://reelzoy.com:3000,https://api.reelzoy.com

# Default Admin (CHANGE IN PRODUCTION)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@1234!
ADMIN_EMAIL=admin@contentplatform.local

# Database
DATABASE_URL=postgresql+asyncpg://editor:changeme@postgres:5432/video_editor

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=videos
MINIO_SECURE=false

# JWT & native auth (generate JWT_SECRET with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars
# Fernet key for TOTP secret encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOTP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Frontend base URL (used in verification & reset email links)
FRONTEND_URL=https://reelzoy.com

# SMTP — leave SMTP_HOST empty to disable email (tokens logged to stdout instead)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_TLS=true

# LLM provider (vision + planning + translation + smart clips)
#   openrouter (default) -> set OPENROUTER_API_KEY  (https://openrouter.ai/keys)
#   gemini               -> set GEMINI_API_KEY      (https://aistudio.google.com/apikey)
#   custom               -> set VISION_MODEL_BASE_URL / PLANNING_MODEL_BASE_URL (local vLLM etc.)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# LLM_API_KEY=            # optional: overrides the provider key above

# Model names (empty = provider default)
#   openrouter: google/gemma-4-31b-it:free
#   gemini:     gemini-3.5-flash-lite
VISION_MODEL_NAME=
PLANNING_MODEL_NAME=
PLANNING_TEMPERATURE=0.1
# Leave empty to use the provider endpoint; set only for a custom/local server
VISION_MODEL_BASE_URL=
PLANNING_MODEL_BASE_URL=

# How video reaches the vision model:
#   auto   -> video clips for openrouter, sampled frames for gemini
#   video  -> send MP4 clips (model must accept video input)
#   frames -> send VISION_FRAME_COUNT JPEG frames per chunk (works with any image model)
VISION_INPUT_MODE=auto
VISION_FRAME_COUNT=3

# vLLM (legacy local fallback for the agent / text tasks)
VLLM_BASE_URL=
VLLM_MODEL=Qwen/Qwen3-VL-7B-Instruct
LLM_TEMPERATURE=0.2

# Whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Security
SECRET_KEY=replace-with-a-long-random-secret-key-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
RATE_LIMIT_UPLOAD=5/minute
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AGENT=10/minute

# Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Frontend server-side API URL (used by TanStack Start server functions to reach the backend)
# In Docker Compose this is the internal service name; in development it's localhost
API_URL=http://api:8000

# Docker Compose service credentials
POSTGRES_DB=video_editor
POSTGRES_USER=editor
POSTGRES_PASSWORD=changeme
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Admin@1234!
