    {
      "name": "👑 Keycloak Admin",
      "description": "Keycloak Admin REST API. Run **Get Admin Token** first — all other requests use `{{keycloak_admin_token}}` via a manual Authorization header (not the collection Bearer).",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Get Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('keycloak_admin_token', b.access_token);",
                  "  console.log('Admin token set, expires in', b.expires_in, 's');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password",            "type": "text" },
                { "key": "client_id",  "value": "admin-cli",           "type": "text" },
                { "key": "username",   "value": "{{admin_username}}",  "type": "text" },
                { "key": "password",   "value": "{{admin_password}}",  "type": "text" }
              ]
            },
            "url": {
