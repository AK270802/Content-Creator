            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_id\": \"{{video_id}}\",\n  \"instruction\": \"Create a 3-minute highlight reel focusing on the key talking points. Remove all pauses and filler words.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/agent/edit",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "agent", "edit"]
            },
            "description": "Generates an edit plan synchronously using the planning LLM. Video must be `READY`.\n\n`llm_available: false` means the LLM was unreachable and a rule-based fallback plan was used.\n\nRate limit: 10/minute."
          },
          "response": []
        }
      ]
