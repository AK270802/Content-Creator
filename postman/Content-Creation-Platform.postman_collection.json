          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type",    "value": "client_credentials",          "type": "text" },
                { "key": "client_id",     "value": "{{keycloak_client_id}}",      "type": "text" },
                { "key": "client_secret", "value": "{{keycloak_client_secret}}",  "type": "text" }
              ]
