                  "const loc = pm.response.headers.get('Location');",
                  "if (loc) {",
                  "  const uid = loc.split('/').pop();",
                  "  pm.collectionVariables.set('keycloak_user_id', uid);",
                  "  console.log('keycloak_user_id set:', uid);",
                  "}"
                ]
              }
            }
          ],
