              "host": ["{{keycloak_url}}"],
              "path": ["realms", "master", "protocol", "openid-connect", "token"]
            },
            "description": "Gets a master-realm admin token via admin-cli (no client secret required). Required for all admin operations below."
          },
          "response": []
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
