  "item": [
    {
      "name": "🔐 Keycloak Auth",
      "description": "OpenID Connect token endpoints for the editor realm. All requests in this folder bypass the collection Bearer auth.",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Get Token (Password Grant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('access_token',  b.access_token);",
                  "  pm.collectionVariables.set('refresh_token', b.refresh_token || '');",
                  "  pm.collectionVariables.set('token_expiry',  String(Date.now() + (b.expires_in - 30) * 1000));",
                  "  console.log('access_token set — expires in', b.expires_in, 's');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type",    "value": "password",                    "type": "text" },
                { "key": "client_id",     "value": "{{keycloak_client_id}}",      "type": "text" },
                { "key": "client_secret", "value": "{{keycloak_client_secret}}",  "type": "text" },
                { "key": "username",      "value": "{{admin_username}}",          "type": "text" },
                { "key": "password",      "value": "{{admin_password}}",          "type": "text" },
                { "key": "scope",         "value": "openid profile email",        "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "{{keycloak_realm}}", "protocol", "openid-connect", "token"]
            },
            "description": "Exchange username + password for access/refresh tokens. Tokens are saved to collection variables automatically."
          },
          "response": []
        },
        {
          "name": "Get Token (Client Credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', b.access_token);",
                  "  pm.collectionVariables.set('token_expiry', String(Date.now() + (b.expires_in - 30) * 1000));",
                  "  console.log('Client credentials token set');",
                  "}"
                ]
              }
