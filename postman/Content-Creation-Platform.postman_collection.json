    {
      "name": "🎬 Videos",
      "description": "Video upload and processing pipeline. Requires valid JWT (auto-injected).",
      "item": [
        {
          "name": "Upload Video",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 202', () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('video_id', b.video_id);",
                  "  console.log('video_id set:', b.video_id);",
                  "  pm.test('Has video_id', () => pm.expect(b.video_id).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select a video file (.mp4, .mov, .avi, .mkv, .webm) — max 2 GB"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/videos/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "videos", "upload"]
            },
            "description": "Streams the file to MinIO then enqueues the full processing pipeline: Whisper transcription → PySceneDetect scene boundary detection → event timeline extraction → AI edit plan generation.\n\nReturns 202 immediately. Rate limit: 5/minute.\n\nAllowed types: video/mp4, video/quicktime, video/x-msvideo, video/x-matroska, video/webm, video/mpeg"
          },
          "response": []
        },
        {
          "name": "Get Video Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  console.log('Video status:', b.status);",
                  "  if (b.status === 'FAILED') console.error('Processing error:', b.error_message);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/videos/{{video_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "videos", "{{video_id}}", "status"]
            },
            "description": "Poll until `status == READY`. Possible values: `PENDING` → `PROCESSING` → `READY` or `FAILED`."
          },
          "response": []
        },
        {
          "name": "Get Video Scenes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const scenes = pm.response.json();",
                  "  pm.test('Returns array', () => pm.expect(scenes).to.be.an('array'));",
                  "  if (scenes.length > 0) {",
                  "    pm.collectionVariables.set('scene_id', scenes[0].id);",
                  "    console.log('scene_id set:', scenes[0].id, '— total scenes:', scenes.length);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/videos/{{video_id}}/scenes",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "videos", "{{video_id}}", "scenes"]
            },
            "description": "Returns ordered scenes with `scene_number`, `start_time`, `end_time`, and presigned `thumbnail_url`. Requires video `READY`."
          },
          "response": []
        },
        {
          "name": "Get Video Transcript",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  console.log('Total segments:', b.total, '| page:', b.page, '| returned:', b.segments.length);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/videos/{{video_id}}/transcript?page=1&page_size=50",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "videos", "{{video_id}}", "transcript"],
              "query": [
                { "key": "page",      "value": "1",   "description": "1-based page number" },
                { "key": "page_size", "value": "50",  "description": "Items per page (1–200, default 50)" }
              ]
            },
            "description": "Paginated transcript segments from Whisper. Each segment has `start_time`, `end_time`, `text`, and optional `speaker`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "✂️ Edit Plans",
      "description": "AI-generated versioned edit plans. Each plan contains segments with actions (`keep`/`cut`/`trim`), captions, text overlays, and trim points. Plans are scoped to the authenticated user via video ownership.",
      "item": [
        {
          "name": "List Edit Plan Versions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const plans = pm.response.json();",
                  "  console.log('Plan versions:', plans.length);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/videos/{{video_id}}/edit-plans",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "videos", "{{video_id}}", "edit-plans"]
            },
            "description": "Returns all plan versions for the video ordered by version ascending (v1, v2, …)."
          },
          "response": []
        },
        {
          "name": "Get Latest Edit Plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('plan_id', b.id);",
                  "  if (b.segments && b.segments.length > 0) {",
                  "    pm.collectionVariables.set('segment_id', b.segments[0].id);",
                  "    console.log('segment_id set:', b.segments[0].id);",
                  "  }",
                  "  console.log('plan_id set:', b.id, '| version:', b.version, '| segments:', b.segments.length);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/videos/{{video_id}}/edit-plan",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "videos", "{{video_id}}", "edit-plan"]
            },
            "description": "Returns the highest-version plan. Auto-captures `plan_id` and `segment_id`."
          },
          "response": []
        },
        {
          "name": "Get Edit Plan by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/edit-plans/{{plan_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "edit-plans", "{{plan_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Patch Edit Plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 409) {",
                  "  console.warn('Plan is not DRAFT — cannot patch. Detail:', pm.response.json().detail);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"segments\": [\n    {\n      \"id\": \"{{segment_id}}\",\n      \"action\": \"keep\",\n      \"caption\": \"Updated caption for this scene\",\n      \"text_overlay\": \"Text overlay content\",\n      \"start_ts\": 0.0,\n      \"end_ts\": 15.5,\n      \"order\": 0\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/edit-plans/{{plan_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "edit-plans", "{{plan_id}}"]
            },
            "description": "Partially updates segments in a DRAFT plan. Only `DRAFT` plans are editable (409 otherwise).\n\nAll segment fields are optional — only provided fields are updated.\n\n`action` values: `keep`, `cut`, `trim`"
          },
          "response": []
        },
        {
          "name": "Approve Edit Plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 202', () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('render_job_id', b.id);",
                  "  console.log('render_job_id set:', b.id, '| render status:', b.status);",
                  "}",
                  "if (pm.response.code === 409) {",
                  "  console.warn('Plan is not DRAFT — cannot approve. Detail:', pm.response.json().detail);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/edit-plans/{{plan_id}}/approve",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "edit-plans", "{{plan_id}}", "approve"]
            },
            "description": "Transitions plan `DRAFT → APPROVED` and enqueues an FFmpeg render job. Returns 202 with the render job. Poll `/render-jobs/{id}` until `COMPLETE`.\n\nRate limit: 10/minute."
          },
          "response": []
        },
        {
          "name": "Revise Edit Plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('plan_id', b.id);",
                  "  console.log('New plan v' + b.version + ' created. plan_id updated:', b.id);",
                  "}",
                  "if (pm.response.code === 429) {",
                  "  console.warn('Daily revision cap hit:', pm.response.json().detail);",
                  "}",
                  "if (pm.response.code === 502) {",
                  "  console.error('Revision LLM error:', pm.response.json().detail);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instruction\": \"Remove all scenes where no one is speaking and tighten the pacing to under 3 minutes\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/videos/{{video_id}}/edit-plans/{{plan_id}}/revise",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "videos", "{{video_id}}", "edit-plans", "{{plan_id}}", "revise"]
            },
            "description": "Sends the current plan + transcript + timeline events to the revision LLM with the given instruction. Creates a new plan version (v+1) as a child of the current plan.\n\nReturns 201 with the new plan. `plan_id` is auto-updated.\n\nRate limit: 10/minute. Daily cap: 20 revisions/user/day (429 when exceeded)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "🎞️ Render Jobs",
      "description": "Poll render job status after approving an edit plan. Render is processed by a Celery worker using FFmpeg.",
      "item": [
        {
          "name": "Get Render Job Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  console.log('Render status:', b.status);",
                  "  if (b.status === 'COMPLETE') console.log('Output URL:', b.output_url);",
                  "  if (b.status === 'FAILED')   console.error('Render error:', b.error_message);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/render-jobs/{{render_job_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "render-jobs", "{{render_job_id}}"]
            },
            "description": "Polls the render job. Status values: `PENDING` → `PROCESSING` → `COMPLETE` or `FAILED`.\n\nWhen `COMPLETE`, `output_url` contains a presigned MinIO URL for the rendered video (valid ~1 hour)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "🤖 Agent",
      "description": "Direct AI agent endpoint for single-shot edit plan generation.",
      "item": [
        {
          "name": "Agent Edit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  console.log('LLM available:', b.llm_available, '| operations:', b.edit_plan.operations.length);",
                  "  if (!b.llm_available) console.warn('LLM unavailable — rule-based fallback used');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
