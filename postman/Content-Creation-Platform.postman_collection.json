            ],
            "url": {
              "raw": "{{keycloak_url}}/admin/realms/{{keycloak_realm}}/users?max=50",
              "host": ["{{keycloak_url}}"],
              "path": ["admin", "realms", "{{keycloak_realm}}", "users"],
              "query": [
                { "key": "max",    "value": "50",  "description": "Max records to return" },
                { "key": "search", "value": "",    "disabled": true, "description": "Search by username/email/name" },
                { "key": "first",  "value": "0",   "disabled": true, "description": "Pagination offset" }
              ]
            }
          },
          "response": []
